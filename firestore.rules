rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only verification stage. Legacy /projects and /settings remain
    // inaccessible from client SDKs until migrated.
    //
    // Assumed data model:
    // users/{uid}/healthHistory/{date}: reserved, fully denied for now.
    // users/{uid}/projects/{id}: id (immutable string matching path),
    // schemaVersion (integer 1), payload (JSON string <= 200000 chars),
    // updatedAt (server timestamp). Only the UID owner can read;
    // all client-side writes are denied. JSON content remains untrusted.
    // users/{uid}/settings/main: reserved, fully denied for now.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid}/projects/{projectId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
