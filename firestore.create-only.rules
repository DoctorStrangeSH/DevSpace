rules_version = '2';

// PROTOTYPE ONLY — not wired into firebase.json, do not publish without
// emulator verification and a review of the live rules / database edition.
// Assumed private model: users/{uid}/projects/{projectId}
// Required, immutable-once-created fields:
//   id: string, 1..150 characters, same as the document ID
//   schemaVersion: integer, exactly 1
//   payload: serialized JSON string, 2..200000 characters (untrusted on read)
//   updatedAt: server timestamp, equal to request.time on creation
// Other paths (healthHistory, settings, legacy projects): fully denied.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data);
    }

    function isValidPrivateProject(data, projectId) {
      return data.keys().hasAll(['id', 'schemaVersion', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['id', 'schemaVersion', 'payload', 'updatedAt'])
        && data.id is string
        && data.id == projectId
        && data.id.size() >= 1
        && data.id.size() <= 150
        && data.id.matches('^[a-zA-Z0-9_-]+$')
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.payload is string
        && data.payload.size() >= 2
        && data.payload.size() <= 200000
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid}/projects/{projectId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && uidUnchanged()
        && isValidPrivateProject(request.resource.data, projectId);
      // Explicitly closed. The validator remains in the update expression to
      // avoid accidentally introducing owner-only schema-free updates later.
      allow update: if false && isOwner(uid) && uidNotModified()
        && isValidPrivateProject(request.resource.data, projectId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
